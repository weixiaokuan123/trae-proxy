#!/bin/sh
# 隐私拦截钩子 · 仓内跳板
#
# 作用：core.hooksPath 指向本仓 .githooks 目录（这个路径永远有效），
# 再由本脚本转发到共享实现。共享目录丢失时明确报错，
# 避免 git 因「钩子目录不存在」而静默跳过防线。
#
# ## 为什么 SHARED 由安装脚本注入，而不是写死
#
# 跳板有个内在矛盾：它住在**各个仓**里，却需要知道**共享目录**在哪。
# 共享目录的位置随机器而异（用户名不同、装在别处也不同），
# 所以没法在本文件里推导——本文件根本不在共享目录旁边。
#
# 写死 `C:/Users/<原作者>/...` 的后果很具体：别人 clone 下来之后，
# 每个仓的跳板都指向一个不存在的目录，于是**每个仓的提交都被拒绝**
# （第 16 行的检查会主动报错并 exit 1）。
# 这比「静默跳过钩子」好一点——至少不会假装有防线——
# 但对不了解内情的人来说仍然是「装完根本没法提交」。
#
# 所以这里的 C:/Users/DanSofar/.config/opencode/.githooks 是占位符，由 install-hooks.ps1 在分发时
# 替换成本机真实路径。改完本文件要记得跑 `install-hooks.ps1 -All` 同步。

set -e

SHARED='C:/Users/DanSofar/.config/opencode/.githooks'

if [ ! -f "$SHARED/pii-scan.js" ]; then
  printf '\n\033[31m✗ 隐私拦截钩子找不到共享目录，已阻止提交\033[0m\n' >&2
  printf '  期望位置：%s\n' "$SHARED" >&2
  printf '  git 对「钩子目录不存在」是静默跳过的，所以这里必须主动报错。\n' >&2
  printf '  修复：powershell -NoProfile -ExecutionPolicy Bypass -File "%s/install-hooks.ps1" -All\n\n' "$SHARED" >&2
  exit 1
fi

exec sh "$SHARED/pre-commit" "$@"
